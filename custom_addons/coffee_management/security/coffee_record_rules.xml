<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Coffee Admin: Full Access to All Records -->
        <record id="rule_coffee_admin_all" model="ir.rule">
            <field name="name">Coffee Admin: Full Access</field>
            <field name="model_id" ref="model_coffee_arrival"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('coffee_management.group_coffee_admin'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
        </record>

        <!-- Quality Analyst: Can only modify quality evaluations they created -->
        <record id="rule_coffee_quality_analyst_own" model="ir.rule">
            <field name="name">Quality Analyst: Own Records</field>
            <field name="model_id" ref="model_coffee_quality_evaluation"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('coffee_management.group_coffee_quality_analyst'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- Contract Team: Can only see contracts (read-only) -->
        <record id="rule_coffee_contract_team_view" model="ir.rule">
            <field name="name">Contract Team: View All Contracts</field>
            <field name="model_id" ref="model_coffee_contract"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('coffee_management.group_coffee_contract_team'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- Stock Team: Can only see stock records (read-only) -->
        <record id="rule_coffee_stock_team_view" model="ir.rule">
            <field name="name">Stock Team: View All Stock</field>
            <field name="model_id" ref="model_coffee_stock_receiving"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('coffee_management.group_coffee_stock_team'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- Viewer: Read-only access to all coffee models -->
        <record id="rule_coffee_viewer_readonly" model="ir.rule">
            <field name="name">Viewer: Read Only Access</field>
            <field name="model_id" ref="model_coffee_arrival"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('coffee_management.group_coffee_viewer'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- Report Viewer: Can only access reports (read-only) -->
        <record id="rule_coffee_report_viewer" model="ir.rule">
            <field name="name">Report Viewer: Read Only Access</field>
            <field name="model_id" ref="model_report_date_range_wizard"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('coffee_management.group_coffee_report_viewer'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

    </data>
</odoo>