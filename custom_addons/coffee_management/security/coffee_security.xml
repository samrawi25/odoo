<odoo>
    <data noupdate="1">

        <!-- ========================================== -->
        <!-- 1. COFFEE MANAGEMENT CATEGORY DEFINITION -->
        <!-- ========================================== -->
        <record id="coffee_management.module_category_coffee" model="ir.module.category">
            <field name="name">Coffee Management System</field>
            <field name="sequence">30</field>
            <field name="visible">True</field>
            <field name="description">All coffee management-related permissions</field>
        </record>

        <!-- ================ -->
        <!-- 1. SECURITY GROUPS -->
        <!-- ================ -->

        <!-- Coffee Admin Group -->
        <record id="group_coffee_admin" model="res.groups">
            <field name="name">Coffee Administrator</field>
            <field name="category_id" ref="coffee_management.module_category_coffee"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Coffee Quality Groups -->
        <record id="group_coffee_quality_analyst" model="res.groups">
            <field name="name">Coffee Quality Analyst</field>
            <field name="category_id" ref="coffee_management.module_category_coffee"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_coffee_quality_manager" model="res.groups">
            <field name="name">Coffee Quality Manager</field>
            <field name="category_id" ref="coffee_management.module_category_coffee"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Coffee Contract Groups -->
        <record id="group_coffee_contract_manager" model="res.groups">
            <field name="name">Coffee Contract Manager</field>
            <field name="category_id" ref="coffee_management.module_category_coffee"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_coffee_contract_team" model="res.groups">
            <field name="name">Coffee Contract Team</field>
            <field name="category_id" ref="coffee_management.module_category_coffee"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Coffee Stock Groups -->
        <record id="group_coffee_stock_manager" model="res.groups">
            <field name="name">Coffee Stock Manager</field>
            <field name="category_id" ref="coffee_management.module_category_coffee"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_coffee_stock_team" model="res.groups">
            <field name="name">Coffee Stock Team</field>
            <field name="category_id" ref="coffee_management.module_category_coffee"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

