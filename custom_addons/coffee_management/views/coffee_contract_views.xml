<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Coffee Contract Form View -->
        <record id="view_coffee_contract_form" model="ir.ui.view">
            <field name="name">coffee.contract.form</field>
            <field name="model">coffee.contract</field>
            <field name="arch" type="xml">
                <form string="Coffee Contract">
                    <header>
                        <button name="action_confirm_contract" string="Confirm" type="object" class="btn-primary" invisible="state != 'draft'"/>

                        <!-- THE FIX: Add the field used in the 'invisible' attribute here -->
                        <field name="fulfillment_percentage" invisible="1"/>
                        <button name="action_done" string="Mark as Done" type="object" invisible="state != 'confirmed' or fulfillment_percentage &lt; 100"/>

                        <button name="action_cancel" string="Cancel" type="object" invisible="state in ['done', 'cancelled']" confirm="Are you sure you want to cancel this contract?"/>
                        <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state not in ['cancelled']"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" name="action_view_contract_orders" type="object" icon="fa-file-text-o">
                                <field name="contract_order_count" widget="statinfo" string="Orders"/>
                            </button>
                            <button class="oe_stat_button" name="action_view_delivery" type="object" icon="fa-truck">
                                <field name="delivery_count" widget="statinfo" string="Deliveries"/>
                            </button>
                            <button class="oe_stat_button" name="action_view_manufacturing_orders" type="object" icon="fa-cogs">
                                <field name="manufacturing_count" widget="statinfo" string="Manufacturing"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1><field name="contract_number" readonly="1"/></h1>
                        </div>

                        <group>
                            <group string="Contract Details">
                                <field name="buyer_id" required="1"/>
                                <field name="contract_date"/>
                                <field name="expected_delivery_date"/>
                            </group>
                            <group string="Shipment Details">
                                <field name="shipment_period_month" required="1"/>
                                <field name="shipment_period_year" required="1"/>
                                <field name="shipment_status" widget="badge"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Contract Lines" name="contract_lines">
                                <field name="contract_line_ids">
                                    <tree editable="bottom">
                                        <field name="product_id"
                                               required="1"
                                               domain="[('is_coffee_product', '=', True)]"
                                               options="{'no_create_edit': True}"/>

                                        <field name="name" optional="show"/>
                                        <field name="quantity_tons" sum="Total Tons"/>
                                        <field name="quantity_kg" sum="Total KG" optional="show" readonly="1"/>
                                        <field name="unit_price_usd_per_lb"/>
                                        <field name="price_per_kg" optional="show" readonly="1"/>
                                        <field name="subtotal_usd" sum="Total Value" widget="monetary" readonly="1"/>
                                        <field name="state" invisible="1"/>
                                    </tree>
                                </field>
                            </page>

                            <page string="Deliveries &amp; Fulfillment" name="deliveries">
                                <group>
                                    <group>
                                        <field name="delivered_kg"/>
                                        <!-- The field is also here, but placing it in the header ensures it's always available -->
                                        <field name="fulfillment_percentage" widget="progressbar"/>
                                    </group>
                                    <group>
                                        <field name="actual_delivery_date" readonly="1"/>
                                    </group>
                                </group>
                            </page>

                            <page string="Internal Notes" name="notes">
                                <field name="notes" nolabel="1" placeholder="Add any internal notes here..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>


        <record id="view_coffee_contract_tree" model="ir.ui.view">
            <field name="name">coffee.contract.tree</field>
            <field name="model">coffee.contract</field>
            <field name="arch" type="xml">
                <tree string="Coffee Contracts">
                    <field name="contract_number"/>
                    <field name="contract_date"/>
                    <field name="buyer_id"/>
                    <field name="shipment_period_month"/>
                    <field name="shipment_period_year"/>
                    <field name="fulfillment_percentage" widget="progressbar"/>
                    <field name="state" widget="badge" decoration-success="state in ['confirmed', 'done']" decoration-danger="state == 'cancelled'" decoration-info="state == 'draft'"/>
                </tree>
            </field>
        </record>

        <!-- Search view remains the same -->
        <record id="coffee_contract_view_search" model="ir.ui.view">
            <field name="name">coffee.contract.view.search</field>
            <field name="model">coffee.contract</field>
            <field name="arch" type="xml">
                <search string="Search Contracts">
                    <field name="contract_number"/>
                    <field name="buyer_id"/>
                    <filter name="state_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                    <filter name="state_confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                        <filter name="group_by_buyer" string="Buyer" context="{'group_by': 'buyer_id'}"/>
                    </group>
                </search>
            </field>
        </record>


        <!-- Action for Coffee Contracts -->
        <record id="action_coffee_contract" model="ir.actions.act_window">
            <field name="name">Coffee Contracts</field>
            <field name="res_model">coffee.contract</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="coffee_contract_view_search"/>
        </record>
    </data>
</odoo>