<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_coffee_contract_order_form" model="ir.ui.view">
            <field name="name">coffee.contract.order.form</field>
            <field name="model">coffee.contract.order</field>
            <field name="arch" type="xml">
                <form string="Coffee Contract Order">
                    <header>
                        <button name="action_check" string="Check" type="object" class="btn-primary" invisible="state != 'draft'"/>
                        <button name="action_approve" string="Approve &amp; Create MO" type="object" class="btn-success" invisible="state != 'checked'"/>
                        <button name="action_cancel" string="Cancel" type="object" invisible="state in ['shipped', 'cancelled']"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,checked,approved,production_done,shipped"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" name="action_view_manufacturing_orders" type="object" icon="fa-cogs" invisible="manufacturing_count == 0">
                                <field name="manufacturing_count" widget="statinfo" string="Manufacturing"/>
                            </button>
                            <button class="oe_stat_button" name="action_view_delivery_orders" type="object" icon="fa-truck" invisible="delivery_count == 0">
                                <field name="delivery_count" widget="statinfo" string="Deliveries"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <!-- THE FIX: The field is only editable when the state is 'draft' -->
                                <field name="contract_ref_id"
                                       readonly="state != 'draft'"
                                       options="{'no_create': True, 'no_open': True}"/>
                                <field name="customer_id" force_save="1"/>
                                <field name="producer_exporter"/>
                            </group>
                            <group>
                                <field name="shipment_date" widget="date"/>
                                <field name="production_urgency" widget="priority"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Products &amp; Quantities" name="order_lines_page">
                                <!-- THE FIX: The lines are now conditionally readonly based on the state. -->
                                <!-- This allows the onchange to work in draft state. -->
                                <field name="order_line_ids" nolabel="1" readonly="state != 'draft'">
                                    <tree editable="bottom">
                                        <field name="product_id" required="1"/>
                                        <field name="quantity"/>
                                        <field name="uom_id"/>
                                    </tree>
                                </field>
                            </page>
                            <!-- ... other pages for Logistics, etc. ... -->
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Coffee Contract Order Tree View -->
        <record id="view_coffee_contract_order_tree" model="ir.ui.view">
            <field name="name">coffee.contract.order.tree</field>
            <field name="model">coffee.contract.order</field>
            <field name="arch" type="xml">
                <tree string="Coffee Contract Orders">
                    <field name="name"/>
                    <field name="contract_ref_id"/>
                    <field name="customer_id"/>
                    <field name="shipment_date"/>
                    <field name="state" widget="badge" decoration-success="state in ['shipped', 'production_done']" decoration-info="state in ['approved']" decoration-warning="state == 'checked'" decoration-danger="state == 'cancelled'"/>
                </tree>
            </field>
        </record>

        <!-- Coffee Contract Order Search View -->
        <record id="view_coffee_contract_order_search" model="ir.ui.view">
            <field name="name">coffee.contract.order.search</field>
            <field name="model">coffee.contract.order</field>
            <field name="arch" type="xml">
                <search string="Search Contract Orders">
                    <field name="name" string="Order Number"/>
                    <field name="contract_ref_id" string="Source Contract"/>
                    <field name="customer_id" string="Customer"/>
                    <filter name="state_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                    <filter name="state_approved" string="Approved" domain="[('state', '=', 'approved')]"/>

                    <group expand="0" string="Group By">
                        <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                        <filter name="group_by_customer" string="Customer" context="{'group_by': 'customer_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Coffee Contract Order Action -->
        <record id="action_coffee_contract_order" model="ir.actions.act_window">
            <field name="name">Coffee Contract Orders</field>
            <field name="res_model">coffee.contract.order</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_coffee_contract_order_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new Coffee Contract Order.
                </p><p>
                These are specific release orders against a master contract, used to trigger the manufacturing process.
            </p>
            </field>
        </record>
    </data>
</odoo>