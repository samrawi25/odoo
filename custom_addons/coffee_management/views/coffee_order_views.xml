<odoo>
    <data>
        <record id="view_coffee_contract_order_form" model="ir.ui.view">
            <field name="name">coffee.contract.order.form</field>
            <field name="model">coffee.contract.order</field>
            <field name="arch" type="xml">
                <form string="Coffee Contract Order">
                    <header>
                        <button name="action_check"
                                string="Check"
                                type="object"
                                class="btn-primary"
                                invisible="state != 'draft'"/>
                        <button name="action_approve"
                                string="Approve &amp; Create MO"
                                type="object"
                                class="btn-success"
                                invisible="state != 'checked'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,checked,approved"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button"
                                    name="action_view_manufacturing_orders"
                                    type="object"
                                    icon="fa-cogs"
                                    invisible="manufacturing_count == 0">
                                <field name="manufacturing_count" widget="statinfo" string="Manufacturing Orders"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="customer_id" readonly="1"/>
                                <field name="producer_exporter"/>
                                <field name="production_urgency" widget="priority"/>
                            </group>
                            <group>
                                <field name="shipment_date" widget="date"/>
                                </group>
                        </group>

                        <group string="Source &amp; Production Link">
                            <field name="contract_ref_id"
                                   placeholder="Link to the main Coffee Contract"
                                   invisible="state != 'draft'"/>
                            <field name="manufacturing_route_id"
                                   placeholder="Route for MO creation"
                                   invisible="state != 'draft'"/>
                        </group>

                        <notebook>
                            <page string="Products &amp; Quantities" name="order_lines_page">
                                <field name="order_line_ids">
                                    <tree string="Contract Order Lines" editable="bottom">
                                        <field name="product_id"/>
                                        <field name="quantity"/>
                                        <field name="uom_id"/>
                                        </tree>
                                </field>
                            </page>

                            <page string="Logistics &amp; Details" name="logistics_details">
                                <group>
                                    <group>
                                        <field name="packing"/>
                                        <field name="bag_publication_order_no"
                                               invisible="packing != 'bags'"/>
                                        <field name="bag_publication_order_date"
                                               invisible="packing != 'bags'"/>
                                    </group>
                                    <group>
                                        <field name="sticker_required"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Compliance &amp; Certifications" name="compliance_certifications">
                                <group>
                                    <group>
                                        <field name="certified_product"/>
                                        <field name="certificate_type" invisible="not certified_product"/>
                                    </group>
                                    <group>
                                        <field name="eudr_compliant"/>
                                        <field name="green_pro_order"/>
                                    </group>
                                </group>
                                <separator string="Coffee Source"/>
                                <group>
                                    <field name="coffee_grown_area"/>
                                    <field name="farmers_names"/>
                                    <field name="ico_certificate_number"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="view_coffee_contract_order_tree" model="ir.ui.view">
            <field name="name">coffee.contract.order.tree</field>
            <field name="model">coffee.contract.order</field>
            <field name="arch" type="xml">
                <tree string="Coffee Contract Orders">
                    <field name="name"/>
                    <field name="customer_id"/>
                    <field name="shipment_date"/>
                    <field name="state" widget="badge"/>
                </tree>
            </field>
        </record>

        <record id="action_coffee_contract_order" model="ir.actions.act_window">
            <field name="name">Coffee Contract Orders</field>
            <field name="res_model">coffee.contract.order</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>